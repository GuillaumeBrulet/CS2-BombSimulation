<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BombSimulation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime : le serveur fournit déjà CounterStrikeSharp et ses
         dépendances, la sortie de build ne doit contenir que le plugin. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.370" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
